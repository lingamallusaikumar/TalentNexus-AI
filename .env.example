# TalentNexus AI - Environment Configuration Example
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

# Flask
FLASK_ENV=local
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_APP=app

# Database (use SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///talentnexus_local.db
# DATABASE_URL=postgresql://user:password@localhost:5432/talentnexus

# Redis (optional - only needed for Celery/SocketIO in production)
# REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here

# OpenAI (optional - for AI-powered features)
# OPENAI_API_KEY=sk-...

# AWS (optional - for file storage)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=talentnexus-resumes
